# Doxyfile - C++ API Documentation for CToon

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "CToon C++"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "A C++ TOON/JSON serialization library"
OUTPUT_DIRECTORY       = @CTOON_DOCS_CPP_OUT@
OUTPUT_LANGUAGE        = English

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

INPUT                  = @PROJECT_SOURCE_DIR@/docs/cpp/mainpage.md \
                          @PROJECT_SOURCE_DIR@/src/bindings/cpp
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.hpp *.hxx
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/docs/cpp/mainpage.md
# ctoon.hpp #includes the plain C header — INCLUDE_PATH lets Doxygen resolve
# it for the include graph without pulling its C API into these C++ docs
# (that lives in docs/c/ instead).
INCLUDE_PATH           = @PROJECT_SOURCE_DIR@/include
EXAMPLE_PATH           =
EXAMPLE_PATTERNS       = *.cpp
EXAMPLE_RECURSIVE      = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_STYLESHEET        = @AWESOME_HTML_STYLESHEET@
HTML_EXTRA_STYLESHEET  = @AWESOME_HTML_EXTRA_STYLESHEET@
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_FOOTER            = @OUTPUT_DIR@/footer.html

GENERATE_LATEX         = NO

HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = png
DOT_CLEANUP            = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = CTOON_API=
SKIP_FUNCTION_MACROS   = YES
