<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CToon Benchmarks</title>
<style>
:root {
  --bg: #0b0e14;
  --bg-panel: #12161f;
  --bg-panel-2: #171c28;
  --border: #232938;
  --text: #e6e9ef;
  --text-dim: #8b93a7;
  --accent: #5b8cff;
  --accent-2: #35d0ba;
  --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.55;
}
.wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px 80px; }
.hero {
  padding: 90px 24px 60px;
  text-align: center;
  background: radial-gradient(ellipse 900px 500px at 50% -10%, rgba(91,140,255,0.20), transparent 60%);
  border-bottom: 1px solid var(--border);
}
.hero .eyebrow {
  font-size: 13px; letter-spacing: .14em; text-transform: uppercase;
  color: var(--accent-2); font-weight: 600; margin-bottom: 18px;
}
.hero h1 { font-size: clamp(28px, 4.4vw, 46px); margin: 0 auto 18px; max-width: 880px; font-weight: 800; letter-spacing: -0.02em; }
.hero p.sub { color: var(--text-dim); font-size: 16px; max-width: 660px; margin: 0 auto; }
.hero .meta { margin-top: 24px; font-family: var(--mono); font-size: 12.5px; color: var(--text-dim); }
section { padding: 56px 0; border-bottom: 1px solid var(--border); }
section:last-of-type { border-bottom: none; }
.kicker { font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-2); font-weight: 700; margin-bottom: 10px; }
h2 { font-size: 26px; margin: 0 0 6px; letter-spacing: -0.01em; }
.corpus-note { color: var(--text-dim); font-size: 13.5px; margin: 0 0 28px; }
h3.op-title { font-size: 17px; margin: 36px 0 12px; }
h3.op-title:first-of-type { margin-top: 8px; }
.chart-panel { background: var(--bg-panel); border: 1px solid var(--border); border-radius: 12px; padding: 20px; height: 340px; margin-bottom: 24px; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-bottom: 8px; }
th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); }
th { color: var(--text-dim); font-weight: 600; text-transform: uppercase; font-size: 11.5px; letter-spacing: .04em; }
td.num, th.num { text-align: right; font-family: var(--mono); }
tr:hover td { background: var(--bg-panel-2); }
footer { text-align: center; color: var(--text-dim); font-size: 12.5px; padding: 40px 24px; font-family: var(--mono); }
</style>
</head>
<body>

<div class="hero">
  <div class="eyebrow">CToon Benchmarks</div>
  <h1>{{ headline }}</h1>
  <p class="sub">{{ subhead|safe }}</p>
  <div class="meta">generated {{ generated_at }}</div>
</div>

<div class="wrap">
{% for sec in sections %}
<section>
  <div class="kicker">{{ sec.title }}</div>
  <h2>{{ sec.title }} bindings</h2>
  <p class="corpus-note">Corpus: {{ sec.corpus_files }} files, {{ "%.1f"|format(sec.corpus_bytes / 1048576) }} MB.</p>

  <div class="chart-panel"><canvas id="{{ sec.chart_id }}"></canvas></div>
  <table>
    <thead>
      <tr>
        <th>Operation</th>
        <th>Library</th>
        <th class="num">MB/s</th>
        <th class="num">docs/s</th>
        <th class="num">Success rate</th>
        <th class="num">Total time (s)</th>
      </tr>
    </thead>
    <tbody>
      {% for row in sec.rows %}
      <tr>
        <td>{{ row.operation }}</td>
        <td>{{ row.library }}</td>
        <td class="num">{{ row.throughput_mb_s }}</td>
        <td class="num">{{ row.docs_per_sec }}</td>
        <td class="num">{{ row.success_rate }}%</td>
        <td class="num">{{ row.total_time_s }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endfor %}
</div>

<footer>ctoon benchmarks &middot; standalone report, no network or server needed to view</footer>

<script>{{ chartjs_source|safe }}</script>
<script>
const CTOON_BENCH_DATA = {{ embedded_json|safe }};
{{ chart_scripts|safe }}
</script>
</body>
</html>
