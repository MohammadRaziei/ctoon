<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CToon Benchmarks</title>
<style>
:root {
  --bg: #0b0e14;
  --bg-panel: #12161f;
  --bg-panel-2: #171c28;
  --border: #232938;
  --text: #e6e9ef;
  --text-dim: #8b93a7;
  --accent: #5b8cff;
  --accent-2: #35d0ba;
  --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.55;
}
.wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px 80px; }
.hero {
  padding: 90px 24px 60px;
  text-align: center;
  background: radial-gradient(ellipse 900px 500px at 50% -10%, rgba(91,140,255,0.20), transparent 60%);
  border-bottom: 1px solid var(--border);
}
.hero .eyebrow {
  font-size: 13px; letter-spacing: .14em; text-transform: uppercase;
  color: var(--accent-2); font-weight: 600; margin-bottom: 18px;
}
.hero h1 { font-size: clamp(28px, 4.4vw, 46px); margin: 0 auto 18px; max-width: 880px; font-weight: 800; letter-spacing: -0.02em; }
.hero p.sub { color: var(--text-dim); font-size: 16px; max-width: 660px; margin: 0 auto; }
.hero .meta { margin-top: 24px; font-family: var(--mono); font-size: 12.5px; color: var(--text-dim); }
section { padding: 56px 0; border-bottom: 1px solid var(--border); }
section:last-of-type { border-bottom: none; }
.kicker { font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-2); font-weight: 700; margin-bottom: 10px; }
h2 { font-size: 26px; margin: 0 0 6px; letter-spacing: -0.01em; }
.corpus-note { color: var(--text-dim); font-size: 13.5px; margin: 0 0 28px; }
.env-note { color: var(--text-dim); font-size: 12.5px; margin: 10px 0 20px; }
h3.op-title { font-size: 17px; margin: 36px 0 12px; }
h3.op-title:first-of-type { margin-top: 8px; }
.chart-panel { background: var(--bg-panel); border: 1px solid var(--border); border-radius: 12px; padding: 20px; height: 340px; margin-bottom: 24px; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-bottom: 8px; }
th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); }
th { color: var(--text-dim); font-weight: 600; text-transform: uppercase; font-size: 11.5px; letter-spacing: .04em; }
td.num, th.num { text-align: right; font-family: var(--mono); }
tr:hover td { background: var(--bg-panel-2); }
code.sample { display: block; background: var(--bg-panel); border: 1px solid var(--border); border-radius: 8px;
  padding: 14px 16px; font-family: var(--mono); font-size: 12.5px; color: var(--text-dim); overflow-x: auto; white-space: pre; }
.check-yes { color: var(--accent-2); font-weight: 700; }
.check-no { color: #ff6b81; font-weight: 700; }
footer { text-align: center; color: var(--text-dim); font-size: 12.5px; padding: 40px 24px; font-family: var(--mono); }
</style>
</head>
<body>

<div class="hero">
  <div class="eyebrow">CToon Benchmarks</div>
  <h1>{{ headline }}</h1>
  <p class="sub">{{ subhead|safe }}</p>
  <div class="meta">generated {{ generated_at }}</div>
</div>

<div class="wrap">
{% if order_check_sample %}
<section>
  <div class="kicker">Method</div>
  <h2>Key order sample</h2>
  <p class="corpus-note">Every "Key order preservation" table below round-trips this exact JSON through that library and checks whether the keys come back in this same order &mdash; deliberately non-alphabetical, with a nested object and an array of objects, so sorting or hash-based reordering would show up.</p>
  <code class="sample">{{ order_check_sample }}</code>
</section>
{% endif %}
{% for sec in sections %}
<section>
  <div class="kicker">{{ sec.title }}</div>
  <h2>{{ sec.title }} bindings</h2>
  <p class="corpus-note">Corpus: {{ sec.corpus_files }} files, {{ "%.1f"|format(sec.corpus_bytes / 1048576) }} MB.</p>

  {% if sec.agg_chart_js %}
  <h3 class="op-title">Average across the whole corpus</h3>
  <div class="chart-panel"><canvas id="{{ sec.agg_chart_id }}"></canvas></div>
  {% endif %}

  {% for oc in sec.op_charts %}
  <h3 class="op-title">{{ oc.title }}</h3>
  <p class="corpus-note">Throughput vs. input size &mdash; one line per library, marker per size bucket.</p>
  <div class="chart-panel"><canvas id="{{ oc.chart_id }}"></canvas></div>
  {% endfor %}
  {% if sec.has_memory %}
  <h3 class="op-title">Peak memory (isolated per library)</h3>
  <div class="chart-panel" style="height:260px"><canvas id="{{ sec.memory_chart_id }}"></canvas></div>
  {% endif %}
  <table>
    <thead>
      <tr>
        <th>Operation</th>
        <th>Library</th>
        <th class="num">MB/s</th>
        <th class="num">docs/s</th>
        <th class="num">Success rate</th>
        <th class="num">Total time (s)</th>
        {% if sec.has_memory %}<th class="num">Peak RSS (MB)</th>{% endif %}
      </tr>
    </thead>
    <tbody>
      {% for row in sec.rows %}
      <tr>
        <td>{{ row.operation }}</td>
        <td>{{ row.library }}</td>
        <td class="num">{{ row.throughput_mb_s }}</td>
        <td class="num">{{ row.docs_per_sec }}</td>
        <td class="num">{{ row.success_rate }}%</td>
        <td class="num">{{ row.total_time_s }}</td>
        {% if sec.has_memory %}<td class="num">{{ row.peak_rss_mb if row.peak_rss_mb is not none else "—" }}</td>{% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if sec.order_check %}
  <h3 class="op-title">Key order preservation</h3>
  <p class="corpus-note">Round-trips the fixed sample below through each library and checks whether keys come back in the same order they went in.</p>
  <table>
    <thead>
      <tr><th>Library</th><th>Order preserved</th><th>Detail</th></tr>
    </thead>
    <tbody>
      {% for oc in sec.order_check %}
      <tr>
        <td>{{ oc.library }}</td>
        <td>{% if oc.preserved %}<span class="check-yes">&#10003; yes</span>{% else %}<span class="check-no">&#10007; no</span>{% endif %}</td>
        <td>{{ oc.detail or "—" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
{% endfor %}

{% if system_info %}
<section>
  <div class="kicker">Environment</div>
  <h2>What machine these numbers ran on</h2>
  <p class="env-note">Recorded automatically by <code>system_info.py</code> at run
    time &mdash; not filled in by hand. Numbers above are only meaningful relative
    to each other on this specific machine; they won't transfer directly to yours.</p>
  <table>
    <tbody>
      <tr><td>CPU</td><td>{{ system_info.cpu_model }}</td></tr>
      <tr><td>Logical cores</td><td>{{ system_info.logical_cores }}</td></tr>
      {% if system_info.ram_gib %}<tr><td>RAM</td><td>{{ system_info.ram_gib }} GiB</td></tr>{% endif %}
      <tr><td>Architecture</td><td>{{ system_info.architecture }}</td></tr>
      <tr><td>OS</td><td>{{ system_info.os }}</td></tr>
      <tr><td>Python</td><td>{{ system_info.python_implementation }} {{ system_info.python_version }}</td></tr>
    </tbody>
  </table>
</section>
{% endif %}
</div>

<footer>ctoon benchmarks &middot; standalone report, no network or server needed to view</footer>

<script>{{ chartjs_source|safe }}</script>
<script>
const CTOON_BENCH_DATA = {{ embedded_json|safe }};
{{ chart_scripts|safe }}
</script>
</body>
</html>
